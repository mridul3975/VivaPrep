# Runtime backend values. Copy to .env for local use; never commit real keys.
GROQ_API_KEY=
VACHANA_API_KEY=
# Google Cloud OAuth client ID (Web application); no client secret is required.
GOOGLE_CLIENT_ID=
# PostgreSQL application traffic: pooled Neon URL with SSL.
# Leave blank only for the temporary, in-memory development mode.
DATABASE_URL=
# Neon migrations use the direct URL; optional for a local non-pooled database.
DATABASE_URL_UNPOOLED=
# Optional locally; Render generates this value for signed upload-session cookies.
SESSION_SECRET=
# Daily app allowances per signed-in user, resetting at midnight UTC.
DAILY_QUESTION_LIMIT=10
DAILY_REVIEW_LIMIT=30
DAILY_TRANSCRIPTION_LIMIT=10
