# Runtime backend values. Copy to .env for local use; never commit real keys.
GROQ_API_KEY=
VACHANA_API_KEY=
# Google Cloud OAuth client ID (Web application); no client secret is required.
GOOGLE_CLIENT_ID=
# PostgreSQL application traffic: pooled Neon URL with SSL.
# Leave blank only for the temporary, in-memory development mode.
DATABASE_URL=
# Neon migrations use the direct URL; optional for a local non-pooled database.
DATABASE_URL_UNPOOLED=
# Optional locally; Render generates this value for signed upload-session cookies.
SESSION_SECRET=
# Daily app allowances per signed-in user, resetting at midnight UTC.
DAILY_QUESTION_LIMIT=10
DAILY_REVIEW_LIMIT=30
DAILY_TRANSCRIPTION_LIMIT=10
# Guest personal AI allowances. The prepared prime-number demo is free.
GUEST_QUESTION_LIMIT=1
GUEST_REVIEW_LIMIT=3
GUEST_TRANSCRIPTION_LIMIT=1
# Shared guest AI ceilings, separate from signed-in accounts.
GUEST_DAILY_QUESTIONS_LIMIT=60
GUEST_DAILY_ANSWERS_LIMIT=180
GUEST_DAILY_TRANSCRIPTIONS_LIMIT=30
# New guest sessions per UTC day, globally and per network peer.
GUEST_DAILY_SESSIONS_LIMIT=200
GUEST_SESSIONS_PER_NETWORK=10
# Set only after verifying your host's forwarded IP chain; 0 trusts no proxy.
# On Render without this, the global guest limit still applies but the small
# per-network threshold is disabled to avoid grouping everyone by the proxy IP.
TRUSTED_PROXY_HOPS=0
